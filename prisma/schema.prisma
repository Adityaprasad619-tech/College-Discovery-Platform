// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model College {
  id          String   @id @default(cuid())
  name        String
  location    String
  fees        Int      // annual fees in INR
  rating      Float    // rating out of 5.0
  placements  String   // average package description
  overview    String   @db.Text
  courses     String   // comma-separated list of major courses
}

model SavedCollege {
  id         String @id @default(cuid())
  userId     String
  collegeId  String

  @@unique([userId, collegeId])
}
